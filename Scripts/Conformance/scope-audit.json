  "rules": {
    "catalog-publication": {
      "ownership": "upstream-host",
      "reason": "Transforms public catalog publication inputs into generated metadata; Native consumes the pinned generated artifact and validates reproduction, then owns runtime interpretation of that metadata.",
      "existingSuiteRules": [
        {
          "suite": "generate-models-strict.test.ts",
          "sha256": "02daf793d9b697da97bfc95dd4d17e58ea487f33a2801f24e6fee239ccf46ef4"
        },
        {
          "suite": "reasoning-options.test.ts",
          "sha256": "78a2bda1a9a4e0320071408a2cdc1f9ae49cad00aacefad8b4d06b2b7598a218"
        }
      ]
    },
    "caller-length-recovery": {
      "ownership": "caller",
      "reason": "Compares output usage with the caller original limit before context clamping to decide compact-and-retry recovery; Native owns provider finish reason and usage, not the caller recovery decision.",
      "existingSuiteRules": [
        {
          "suite": "retry.test.ts",
          "sha256": "5154cdbc5ec69d84e70ea9e501653fbb317129726760291ed4babc5db2fcb90e"
        },
        {
          "suite": "context-estimate.test.ts",
          "sha256": "4002542241f29459f7f74c977e1a86af069597499836bc67ac7eb0bfcee8c603"
        }
      ]
    },
    "typescript-type-barrel": {
      "ownership": "upstream-host",
      "reason": "Asserts which JavaScript runtime exports are absent from a TypeScript type-only extension compatibility barrel; no provider operation, authentication flow, or normalized event is executed.",
      "existingSuiteRules": [
        {
          "suite": "models-entry.test.ts",
          "sha256": "0e7dd169dadc35bbfbc1a6e8d2c17a80ec5bb8784465fdbb339cbe5b1dec4383"
        },
        {
          "suite": "message-types.test.ts",
          "sha256": "4e0e5fb22a996d88d7873fcc2c837153d3a0400ccd2d7fb9952c49737ce889ba"
        }
      ]
    },
    "caller-model-collection": {
      "ownership": "caller",
      "reason": "Registers caller-supplied JavaScript Provider objects and reads their callback catalogs; object replacement identity, mutable registration and best-effort collection reads precede provider authentication or wire dispatch. Native catalog metadata and provider request dispatch remain in scope.",
      "existingSuiteRules": [
        {
          "suite": "compat-env.test.ts",
          "sha256": "c2125b30f6324772c4b22a9def8fabf14b585c6073fd2f68676c6beb88cad678"
        },
        {
          "suite": "faux-provider.test.ts",
          "sha256": "730d01cafc27867181f06dbe7977f77b8992170c53e5e72cb97141e02aa1c7ba"
        }
      ]
    },
    "caller-model-union": {
      "ownership": "caller",
      "reason": "Narrows caller-constructed TypeScript model unions, including values forced through incompatible casts, before provider dispatch. Native uses ProviderOutputModality and model route/capability validation; this rule does not exclude provider catalog metadata or request validation.",
      "existingSuiteRules": [
        {
          "suite": "message-types.test.ts",
          "sha256": "4e0e5fb22a996d88d7873fcc2c837153d3a0400ccd2d7fb9952c49737ce889ba"
        }
      ]
    },
    "host-provider-implementation-map": {
      "ownership": "upstream-host",
      "reason": "Validates JavaScript callback implementation maps supplied to createProvider, including an absent synthetic API function. Native implements its own fixed wire-protocol registry and does not expose JavaScript callback provider injection.",
      "existingSuiteRules": [
        {
          "suite": "compat-env.test.ts",
          "sha256": "c2125b30f6324772c4b22a9def8fabf14b585c6073fd2f68676c6beb88cad678"
        },
        {
          "suite": "faux-provider.test.ts",
          "sha256": "730d01cafc27867181f06dbe7977f77b8992170c53e5e72cb97141e02aa1c7ba"
        }
      ]
    },
    "host-lazy-api-module": {
      "ownership": "upstream-host",
      "reason": "Observes lazy JavaScript module callback loading and the presence of function properties; no provider HTTP request or Native wire implementation is executed.",
      "existingSuiteRules": [
        {
          "suite": "lazy-module-load.test.ts",
          "sha256": "42dbe0d61885e00039f3bd437bb55861db07a74809d5f034a27da94fb0d43731"
        }
      ]
    },
    "typescript-api-literal": {
      "ownership": "upstream-host",
      "reason": "Assigns a TypeScript Api union literal and compares the string to itself. No runtime registry or provider is read.",
      "existingSuiteRules": [
        {
          "suite": "message-types.test.ts",
          "sha256": "4e0e5fb22a996d88d7873fcc2c837153d3a0400ccd2d7fb9952c49737ce889ba"
        }
      ]
    },
    "version-publication": {
      "ownership": "upstream-host",
      "reason": "Checks that the TypeScript generated package-version constant matches package.json; its source names the version synchronization script. Native client identity version and wire headers remain tested separately.",
      "existingSuiteRules": [
        {
          "suite": "model-data-validation.test.ts",
          "sha256": "d2f833b7377f3c1aa2c421e1466c0f9e790b7beed584a82657d3d63fdfb49d50"
        }
      ]
    },
    "caller-transcript-tool-boundary": {
      "ownership": "caller",
      "reason": "Folds caller transcript tool declarations/removals into current tools and a history boundary. This case only calls resolveTranscriptTools; provider projection of an assembled request remains in scope.",
      "existingSuiteRules": [
        {
          "suite": "system-message-replay.test.ts",
          "sha256": "0a5e531df99ffb5d89f73056775a7e31e1e426e860ca894051c8ad9d8b7bc11b"
        }
      ]
    }
  },
